# Copy to deploy/.env and fill in. deploy/.env holds a secret: never commit it.

# The name users add to Claude; Caddy gets its certificate. https://<this>/mcp is the MCP endpoint.
SHOWNTELL_DOMAIN=showntell.example.com

# Sign-in: google, entra or generic (docs/self-hosting.md has the registration steps).
SHOWNTELL_OIDC=google
SHOWNTELL_OIDC_CLIENT_ID=
SHOWNTELL_OIDC_CLIENT_SECRET=
# entra only: the directory (tenant) ID, a GUID.
SHOWNTELL_ENTRA_TENANT=
# generic only: the provider's issuer URL.
SHOWNTELL_OIDC_ISSUER=
# Comma-separated. Required for google and generic; for entra, empty means anyone in the tenant.
SHOWNTELL_ALLOWED_DOMAINS=example.com

# Fair use; these are the defaults.
# SHOWNTELL_QUOTA_NARRATION_MIN=8
# SHOWNTELL_QUOTA_SLIDES=60
# SHOWNTELL_QUOTA_WRITING=3
# SHOWNTELL_QUOTA_WALKTHROUGHS=200
# SHOWNTELL_QUOTA_STORAGE_GB=2
# SHOWNTELL_QUOTA_RETENTION_DAYS=180
# SHOWNTELL_QUOTA_CALLS_PER_MIN=60
# SHOWNTELL_QUOTA_BROWSERS=2
